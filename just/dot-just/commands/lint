#!/usr/bin/env bash
set -euo pipefail

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/lib/lib.sh"

declare -a OXLINT_PATHS=()
declare -a STYLELINT_PATHS=()
declare -a LINT_SELECTORS=()
declare -a MIX_LINT_ROOTS=()

default_lint_paths() {
  local app
  local path
  local root

  while read -r app root; do
    printf "%s\n" "$root"
  done < <(app_entries)

  for path in "$REPO_ROOT/oxlint.config.ts" "$REPO_ROOT/stylelint.config.js"; do
    [[ -e "$path" ]] && printf "%s\n" "$path"
  done
}

add_mix_lint_root() {
  local root="$1"

  MIX_LINT_ROOTS+=("$root")
}

has_mix_lint_files() {
  local path="$1"

  find "$path" \
    \( \
      -path '*/_build' -o \
      -path '*/_build/*' -o \
      -path '*/deps' -o \
      -path '*/deps/*' \
    \) -prune \
    -o -type f \( -name '*.ex' -o -name '*.exs' -o -name '*.heex' \) -print -quit |
    grep -q .
}

add_lint_file() {
  local file="$1"
  local root

  case "$file" in
    *.ex|*.exs|*.heex)
      root="$(elixir_root_for_path "$file")" || return 0
      add_mix_lint_root "$root"
      ;;
    *.css)
      STYLELINT_PATHS+=("$(relative_path "$file")")
      ;;
    *.astro)
      return
      ;;
    *.cjs|*.cts|*.js|*.jsx|*.mjs|*.mts|*.ts|*.tsx)
      OXLINT_PATHS+=("$(relative_path "$file")")
      ;;
    *)
      OXLINT_PATHS+=("$(relative_path "$file")")
      ;;
  esac
}

add_lint_path() {
  local path
  local root

  path="$(resolve_path "$1")"
  [[ -e "$path" ]] || die "path does not exist: $path"

  if [[ -d "$path" ]]; then
    if root="$(elixir_root_for_path "$path")"; then
      if [[ "$path" == "$root" ]]; then
        add_mix_lint_root "$root"

        if [[ -d "$root/assets/css" ]]; then
          add_lint_path "$root/assets/css"
        fi

        return
      fi
    fi

    if has_mix_lint_files "$path"; then
      root="$(elixir_root_for_path "$path")" || root=""
      [[ -n "$root" ]] && add_mix_lint_root "$root"
    fi

    while IFS= read -r -d '' file; do
      add_lint_file "$file"
    done < <(
      find "$path" \
        \( \
          -path '*/.astro' -o \
          -path '*/.astro/*' -o \
          -path '*/.tanstack' -o \
          -path '*/.tanstack/*' -o \
          -path '*/.vite' -o \
          -path '*/.vite/*' -o \
          -path '*/_build' -o \
          -path '*/_build/*' -o \
          -path '*/deps' -o \
          -path '*/deps/*' -o \
          -path '*/dist' -o \
          -path '*/dist/*' -o \
          -path '*/node_modules' -o \
          -path '*/node_modules/*' -o \
          -path '*/priv/static/assets' -o \
          -path '*/priv/static/assets/*' \
        \) -prune \
        -o -type f \( \
          -name '*.css' -o \
          -name '*.cjs' -o \
          -name '*.cts' -o \
          -name '*.js' -o \
          -name '*.jsx' -o \
          -name '*.mjs' -o \
          -name '*.mts' -o \
          -name '*.ts' -o \
          -name '*.tsx' \
        \) -print0
    )
    return
  fi

  if [[ -f "$path" ]]; then
    add_lint_file "$path"
    return
  fi
}

unique_oxlint_paths() {
  [[ "${#OXLINT_PATHS[@]}" -gt 0 ]] || return 0

  printf "%s\n" "${OXLINT_PATHS[@]}" | awk 'NF && !seen[$0]++'
}

unique_stylelint_paths() {
  [[ "${#STYLELINT_PATHS[@]}" -gt 0 ]] || return 0

  printf "%s\n" "${STYLELINT_PATHS[@]}" | awk 'NF && !seen[$0]++'
}

unique_mix_lint_roots() {
  [[ "${#MIX_LINT_ROOTS[@]}" -gt 0 ]] || return 0

  printf "%s\n" "${MIX_LINT_ROOTS[@]}" | awk 'NF && !seen[$0]++'
}

selector_summary() {
  printf "%s\n" "${LINT_SELECTORS[@]}" | awk 'NF && !seen[$0]++' | paste -sd ' ' -
}

selector_display_suffix() {
  if [[ "${#LINT_SELECTORS[@]}" -gt 0 ]]; then
    printf " %s" "$(selector_summary)"
  fi
}

lint_summary_details() {
  local count="$1"
  local label
  local unit="files"

  if [[ "${#LINT_SELECTORS[@]}" -eq 0 ]]; then
    label="repo defaults"
  else
    label="$(selector_summary)"
  fi

  [[ "$count" -eq 1 ]] && unit="file"
  printf "  files: %s (%s %s)" "$label" "$count" "$unit"
}

run_oxlint() {
  local path
  local -a paths=()
  local display_command
  local details

  while IFS= read -r path; do
    paths+=("$path")
  done < <(unique_oxlint_paths)

  [[ "${#paths[@]}" -gt 0 ]] || return 0

  require_command pnpm
  display_command="pnpm exec oxlint$(selector_display_suffix)"
  details="$(lint_summary_details "${#paths[@]}")"
  JUST_STEP_DISPLAY_COMMAND="$display_command" JUST_STEP_DISPLAY_DETAILS="$details" \
    collect_step "Oxlint" "$REPO_ROOT" pnpm exec oxlint "${paths[@]}"
}

run_stylelint() {
  local path
  local -a paths=()
  local display_command
  local details

  while IFS= read -r path; do
    paths+=("$path")
  done < <(unique_stylelint_paths)

  [[ "${#paths[@]}" -gt 0 ]] || return 0

  require_command pnpm
  display_command="pnpm exec stylelint$(selector_display_suffix)"
  details="$(lint_summary_details "${#paths[@]}")"
  JUST_STEP_DISPLAY_COMMAND="$display_command" JUST_STEP_DISPLAY_DETAILS="$details" \
    collect_step "Stylelint" "$REPO_ROOT" pnpm exec stylelint "${paths[@]}"
}

check_ex_slop_contract() {
  local root="$1"
  local dependency_details="  requires: {:ex_slop, ...} in mix.exs"
  local plugin_details="  requires: plugins: [{ExSlop, ...}] in .credo.exs"

  JUST_STEP_DISPLAY_COMMAND="grep -Eq '{[[:space:]]*:ex_slop[[:space:]]*,' mix.exs" JUST_STEP_DISPLAY_DETAILS="$dependency_details" \
    collect_step "ExSlop Dependency" "$root" grep -Eq '\{[[:space:]]*:ex_slop[[:space:]]*,' mix.exs

  JUST_STEP_DISPLAY_COMMAND="grep -Eq '{[[:space:]]*ExSlop[[:space:]]*,' .credo.exs" JUST_STEP_DISPLAY_DETAILS="$plugin_details" \
    collect_step "ExSlop Credo Plugin" "$root" bash -c "test -f .credo.exs && grep -Eq '\\{[[:space:]]*ExSlop[[:space:]]*,' .credo.exs"
}

run_mix_lint() {
  local root
  local -a roots=()

  while IFS= read -r root; do
    roots+=("$root")
  done < <(unique_mix_lint_roots)

  [[ "${#roots[@]}" -gt 0 ]] || return 0

  require_command mix

  for root in "${roots[@]}"; do
    collect_step "Mix Format" "$root" mix format --check-formatted
    check_ex_slop_contract "$root"
    collect_step "Credo" "$root" mix credo --strict
    collect_step "Sobelow" "$root" mix sobelow --private --exit --threshold high
    collect_step "ExDNA" "$root" mix ex_dna --min-mass 40 --max-clones 0
    collect_step "Reach" "$root" mix reach.check --arch --smells --strict
    collect_step "Dialyzer" "$root" mix dialyzer --format short
  done
}

main() {
  local path

  cd "$REPO_ROOT"

  if [[ "$#" -eq 0 ]]; then
    while IFS= read -r path; do
      add_lint_path "$path"
    done < <(default_lint_paths)
  else
    for path in "$@"; do
      LINT_SELECTORS+=("$path")
      add_lint_path "$path"
    done
  fi

  if [[ "${#OXLINT_PATHS[@]}" -eq 0 && "${#STYLELINT_PATHS[@]}" -eq 0 && "${#MIX_LINT_ROOTS[@]}" -eq 0 ]]; then
    printf "No lint-compatible files selected.\n"
    return
  fi

  run_mix_lint
  run_oxlint
  run_stylelint
  fail_if_steps_failed
}

main "$@"
